// Kloister database schema (SPEC §4).
//
// Tables are added milestone by milestone; M1 covers accounts, sessions,
// the audit log and app settings; M2 adds projects, members and teams; M3
// adds work items, buckets, labels, checklists and sprints; M5 adds notes,
// attachments and notifications. Every table
// has a uuid `id`, plus `createdAt`/`updatedAt` unless SPEC §4 says otherwise.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// System-wide role (SPEC §3.1). Project roles live on ProjectMember.
enum SystemRole {
  ADMIN
  USER
}

/// A local account. Accounts are created by admins only; there is no self sign-up.
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  /// Stored lowercased so lookups are case-insensitive.
  email              String     @unique
  displayName        String
  /// argon2id hash; never returned by the API.
  passwordHash       String
  systemRole         SystemRole @default(USER)
  /// Set when an admin creates the account or resets its password.
  mustChangePassword Boolean    @default(true)
  isActive           Boolean    @default(true)
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  /// Per-user theme override (M6); empty means "use default".
  themePrefs         Json       @default("{}")
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  /// Sole private space, kept unchanged when this account is deactivated.
  personalSpace Project? @relation("PersonalOwner")
  sessions      Session[]
  auditLogs     AuditLog[]
  memberships   ProjectMember[]
  createdItems  WorkItem[]
  notes         Note[]
  attachments   Attachment[]
  notifications Notification[]  @relation("NotificationRecipient")
  causedNotices Notification[]  @relation("NotificationActor")
}

/// A server-side login session. The cookie carries a random token; only its
/// SHA-256 hash is stored, so a database leak does not leak live sessions.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  /// Absolute expiry, fixed at login.
  expiresAt  DateTime
  /// Drives the idle timeout.
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only record of security-relevant and admin actions. It has only
/// `createdAt` because entries are never updated.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Null for actions with no signed-in actor (failed logins, CLI bootstrap).
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  /// Set for project-scoped actions (M2 onwards).
  projectId  String?  @db.Uuid
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  /// SetNull keeps the history if an actor row is ever removed.
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([projectId])
}

/// Admin-editable settings, one JSON value per key (security, branding, …).
model AppSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Per-project role (SPEC §3.2).
enum ProjectRole {
  PM
  LEAD
  MEMBER
  VIEWER
}

/// Which items a Member or Viewer sees (SPEC §3.3). PM and Lead see everything.
enum Visibility {
  ALL
  BUCKETS
  OWN
  TEAMS
}

/// Role inside an optional project team (SPEC §3.5).
enum TeamRole {
  LEAD
  MEMBER
}

/// An ordinary project (created by admins) or an owner-only personal space
/// initialized on first use (SPEC §3.1, §3.6).
model Project {
  id             String    @id @default(uuid()) @db.Uuid
  /// 2–6 uppercase letters for ordinary projects; null for personal spaces.
  key            String?   @unique
  /// Set only on a private personal space; ownership is independent of membership.
  ownerId        String?   @unique @db.Uuid
  owner          User?     @relation("PersonalOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name           String
  description    String    @default("")
  /// Archived projects are read-only and hidden from the default project list.
  archivedAt     DateTime?
  /// membersCanAssignOthers (M2), statusToBucket rules (M3), ADO settings (M8).
  settings       Json      @default("{}")
  /// Last item number handed out; numbers are never reused, so `KLO-42`
  /// always means the same item.
  lastItemNumber Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members ProjectMember[]
  teams   Team[]
  buckets Bucket[]
  sprints Sprint[]
  labels  Label[]
  items   WorkItem[]
}

/// A user's membership of a project. A project always keeps at least one
/// active PM (SPEC §3.2).
model ProjectMember {
  id               String      @id @default(uuid()) @db.Uuid
  projectId        String      @db.Uuid
  userId           String      @db.Uuid
  role             ProjectRole
  visibility       Visibility  @default(ALL)
  /// Buckets visible under `BUCKETS` scope (SPEC §4); bucket rows arrive in M3.
  allowedBucketIds String[]    @default([]) @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMemberships TeamMember[]
  assignments     WorkItemAssignee[]

  @@unique([projectId, userId])
  @@index([userId])
}

/// An optional team inside a project (SPEC §3.5). Projects work without any.
model Team {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members TeamMember[]
  items   WorkItem[]

  @@unique([projectId, name])
  /// Target of TeamMember's composite key, which keeps team and membership in one project.
  @@unique([id, projectId])
}

/// A project member's place in a team. The composite keys guarantee the user
/// is a member of the team's own project; leaving the project removes the
/// user from its teams.
model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  role      TeamRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team          Team          @relation(fields: [teamId, projectId], references: [id, projectId], onDelete: Cascade)
  projectMember ProjectMember @relation(fields: [projectId, userId], references: [projectId, userId], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([projectId, userId])
}

/// Work item types; allowed parents are in SPEC §4.1.
enum ItemType {
  EPIC
  FEATURE
  STORY
  TASK
  BUG
}

/// Work item status. Status and bucket are independent fields (SPEC §4.2).
enum ItemStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

/// What moving a card into a bucket does to its status (SPEC §4.2).
enum BucketRule {
  NONE
  SET
  SET_IF_NOT_STARTED
}

/// Sprint lifecycle. A project has at most one ACTIVE sprint.
enum SprintState {
  PLANNED
  ACTIVE
  CLOSED
}

/// A board column (SPEC §4). New projects get the default buckets of SPEC §4.2.
model Bucket {
  id            String      @id @default(uuid()) @db.Uuid
  projectId     String      @db.Uuid
  name          String
  /// Column order, ascending (fractional, so a move rewrites one row).
  position      Float
  onEnterMode   BucketRule  @default(NONE)
  /// Status set by `SET` and `SET_IF_NOT_STARTED`; null for `NONE`.
  onEnterStatus ItemStatus?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   WorkItem[]

  /// Target of WorkItem's composite key, which keeps item and bucket in one project.
  @@unique([id, projectId])
  @@index([projectId, position])
}

/// A sprint (SPEC §4). Dates are calendar days without a time of day.
model Sprint {
  id               String      @id @default(uuid()) @db.Uuid
  projectId        String      @db.Uuid
  name             String
  startDate        DateTime    @db.Date
  endDate          DateTime    @db.Date
  state            SprintState @default(PLANNED)
  /// Overrides the iteration path built from the project's ADO root (SPEC §7.3).
  adoIterationPath String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   WorkItem[]

  @@index([projectId, startDate])
}

/// A label (SPEC §4). Names are unique per project.
model Label {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String
  /// `#rrggbb`.
  colour    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   WorkItemLabel[]

  @@unique([projectId, name])
  /// Target of WorkItemLabel's composite key, which keeps label and item in one project.
  @@unique([id, projectId])
}

/// A work item (SPEC §4). Composite keys keep the parent and bucket in the
/// item's project. Sprint and team are checked against the project in code,
/// because deleting a sprint or team must clear only that one column.
model WorkItem {
  id          String     @id @default(uuid()) @db.Uuid
  projectId   String     @db.Uuid
  /// Per-project sequence taken from `Project.lastItemNumber`.
  number      Int
  type        ItemType
  /// Deleting an item with children is refused unless its whole subtree is
  /// deleted in the same statement (SPEC §4.1).
  parentId    String?    @db.Uuid
  title       String
  /// Sanitized HTML (SPEC §5).
  description String     @default("")
  status      ItemStatus @default(NOT_STARTED)
  /// 1 (highest) to 4.
  priority    Int        @default(2)
  /// Required for STORY, TASK and BUG; optional for EPIC and FEATURE. A
  /// bucket that still holds items cannot be deleted.
  bucketId    String?    @db.Uuid
  sprintId    String?    @db.Uuid
  teamId      String?    @db.Uuid
  startDate   DateTime?  @db.Date
  dueDate     DateTime?  @db.Date
  /// Order within the bucket, ascending (fractional index).
  position    Float
  createdById String     @db.Uuid
  /// Set when the status becomes DONE, cleared when it leaves DONE.
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        WorkItem?            @relation("WorkItemHierarchy", fields: [parentId, projectId], references: [id, projectId], onDelete: NoAction)
  children      WorkItem[]           @relation("WorkItemHierarchy")
  bucket        Bucket?              @relation(fields: [bucketId, projectId], references: [id, projectId], onDelete: NoAction)
  sprint        Sprint?              @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  team          Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy     User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assignees     WorkItemAssignee[]
  labels        WorkItemLabel[]
  checklist     ChecklistItem[]
  blockedBy     WorkItemDependency[] @relation("BlockedItem")
  blocks        WorkItemDependency[] @relation("BlockingItem")
  notes         Note[]
  attachments   Attachment[]
  notifications Notification[]

  @@unique([projectId, number])
  /// Target of the composite keys that keep links inside one project.
  @@unique([id, projectId])
  @@index([projectId, bucketId, position])
  @@index([parentId])
  @@index([sprintId])
  @@index([teamId])
}

/// An item's assignee. The composite key ties the assignee to a membership
/// of the item's project, so leaving the project removes the assignment.
model WorkItemAssignee {
  id         String   @id @default(uuid()) @db.Uuid
  workItemId String   @db.Uuid
  projectId  String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workItem      WorkItem      @relation(fields: [workItemId, projectId], references: [id, projectId], onDelete: Cascade)
  projectMember ProjectMember @relation(fields: [projectId, userId], references: [projectId, userId], onDelete: Cascade)

  @@unique([workItemId, userId])
  @@index([projectId, userId])
}

/// "Blocked by" links between items of one project. They may cross teams and
/// never form a cycle (checked in code).
model WorkItemDependency {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  blockedItemId  String   @db.Uuid
  blockingItemId String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  blockedItem  WorkItem @relation("BlockedItem", fields: [blockedItemId, projectId], references: [id, projectId], onDelete: Cascade)
  blockingItem WorkItem @relation("BlockingItem", fields: [blockingItemId, projectId], references: [id, projectId], onDelete: Cascade)

  @@unique([blockedItemId, blockingItemId])
  @@index([blockingItemId])
}

/// Labels on an item; label and item belong to the same project.
model WorkItemLabel {
  id         String   @id @default(uuid()) @db.Uuid
  workItemId String   @db.Uuid
  projectId  String   @db.Uuid
  labelId    String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workItem WorkItem @relation(fields: [workItemId, projectId], references: [id, projectId], onDelete: Cascade)
  label    Label    @relation(fields: [labelId, projectId], references: [id, projectId], onDelete: Cascade)

  @@unique([workItemId, labelId])
  @@index([labelId])
}

/// One checklist line. Checklists show progress and never change status (SPEC §4.2).
model ChecklistItem {
  id         String   @id @default(uuid()) @db.Uuid
  workItemId String   @db.Uuid
  text       String
  done       Boolean  @default(false)
  /// Order, ascending (fractional index).
  position   Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId, position])
}

/// A note in an item's thread (SPEC §4, §6). Notes are deleted with their item.
model Note {
  id         String    @id @default(uuid()) @db.Uuid
  workItemId String    @db.Uuid
  authorId   String    @db.Uuid
  /// Sanitized HTML (SPEC §5): mentions as `span[data-mention]`, images only
  /// from the item's own inline-image endpoint.
  body       String
  /// Set when the author changes the note.
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  /// Accounts are deactivated, never deleted, so authors are kept.
  author   User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([workItemId, createdAt])
}

/// A file attached to an item, or an image pasted or dropped into its
/// description or notes (`inline`). The bytes live outside the web root at
/// `<attachments dir>/<projectId>/<storedName>` (SPEC §5); both kinds count
/// toward the project's quota.
model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  workItemId   String   @db.Uuid
  uploaderId   String   @db.Uuid
  /// The uploaded file name, cleaned of path parts and control characters.
  originalName String
  /// Random file name on disk; never derived from user input.
  storedName   String   @unique
  sizeBytes    Int
  /// Detected from the content, never taken from the client.
  mimeType     String
  /// Hex SHA-256 of the content.
  sha256       String
  /// True for images in a description or note; these are not listed as attachments.
  inline       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([workItemId, inline, createdAt])
}

/// In-app notification types (SPEC §6).
enum NotificationType {
  ASSIGNED
  MENTIONED
  DUE_TOMORROW
  OVERDUE
  STATUS_CHANGED
}

/// An in-app notification (SPEC §4, §6). Deleted with its item; shown only
/// while the recipient can still see the item.
model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  type       NotificationType
  workItemId String           @db.Uuid
  /// Null for due-date notifications (no actor).
  actorId    String?          @db.Uuid
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user     User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actor    User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([workItemId])
}
